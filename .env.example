# Only local development. Run `npm run setup` to generate a private password.
POSTGRES_DB=samokettik
POSTGRES_USER=samokettik
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=54329
# Host tools connect through the published port; Compose overrides this URL internally.
DATABASE_URL=postgresql://samokettik:replace-with-local-password@127.0.0.1:54329/samokettik
API_HOST=127.0.0.1
API_PORT=3001
API_LOG_LEVEL=info
WEB_PORT=5173
VITE_PROXY_TARGET=http://127.0.0.1:3001
DEMO_SEED_ENABLED=true
# Temporary local demo identity adapter, not production authentication.
DEMO_AUTH_ENABLED=false
DEMO_USER_RU_TOKEN=replace-with-ru-token
DEMO_USER_KY_TOKEN=replace-with-ky-token
BOOKING_JOB_POLL_MS=1000
BOOKING_JOB_BATCH_SIZE=50
BOOKING_WORKER_STALE_MS=10000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_RECONCILE_MS=3000
WS_HEARTBEAT_MS=15000
WS_TICKET_SECONDS=30
WS_MAX_CLIENTS=100
WS_MAX_BUFFERED_BYTES=1048576
