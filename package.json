{
  "name": "samokettik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "^22.12.0 || ^24.0.0", "npm": ">=10" },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "npm run build -w @samokettik/contracts && node scripts/dev.mjs",
    "dev:api": "npm run dev -w @samokettik/server",
    "dev:web": "npm run dev -w @samokettik/web",
    "dev:worker": "npm run dev:worker -w @samokettik/server",
    "typecheck": "npm run build -w @samokettik/contracts && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "build": "npm run build -w @samokettik/contracts && npm run build -w @samokettik/server && npm run build -w @samokettik/web",
    "db:generate": "npm run db:generate -w @samokettik/server",
    "db:migrate": "npm run db:migrate -w @samokettik/server",
    "db:seed": "npm run db:seed -w @samokettik/server",
    "db:check": "npm run db:check -w @samokettik/server",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "demo:reservations": "node scripts/demo-reservations.mjs",
    "demo:trips": "node scripts/demo-trips.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "infra:up": "docker compose up -d --wait postgres",
    "compose:up": "docker compose up --build -d --wait",
    "compose:down": "docker compose down"
  },
  "overrides": { "@esbuild-kit/core-utils": { "esbuild": "0.25.12" } },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
